{
  "name": "waynepdf",
  "version": "0.1.0",
  "description": "Write Markdown. Get a beautiful PDF. Offline, private, and yours to configure.",
  "homepage": "https://waynepdf.mgbah.dev",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:parallel": "playwright test --project=parallel",
    "test:e2e:paged": "playwright test --project=paged",
    "test:e2e:update": "playwright test --update-snapshots",
    "lint": "eslint src tests scripts",
    "gen:icons": "node scripts/generate-icons.mjs",
    "format": "prettier --write \"src/**/*.{js,jsx,json,css}\" \"tests/**/*.{js,jsx}\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@fontsource/noto-sans-hebrew": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@fontsource/noto-sans-tc": "^5.3.0",
    "@vscode/markdown-it-katex": "^1.1.2",
    "codemirror": "^5.65.0",
    "dompurify": "^3.4.13",
    "highlight.js": "11.9.0",
    "idb": "^8.0.3",
    "js-yaml": "^5.3.0",
    "jschardet": "^3.1.4",
    "jszip": "^3.10.1",
    "katex": "^0.16.47",
    "markdown-it": "14.1.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.16.1",
    "nonaction": "^0.0.5",
    "normalize.css": "^8.0.1",
    "pagedjs": "^0.4.3",
    "react": "^18.3.1",
    "react-codemirror2": "^8.0.0",
    "react-dom": "^18.3.1",
    "styled-components": "^6.1.13",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@playwright/test": "^1.48.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "^9.12.0",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "iconv-lite": "^0.7.3",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "sharp": "^0.35.3",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.2",
    "workbox-window": "^7.1.0"
  }
}
